{
  "site": "zhihu",
  "name": "search",
  "command": "opencli zhihu search",
  "usage": "opencli zhihu search <query> [options]",
  "access": "read",
  "description": "知乎搜索",
  "browser": true,
  "domain": "www.zhihu.com",
  "positionals": [
    {
      "name": "query",
      "type": "str",
      "positional": true,
      "required": true,
      "help": "Search query"
    }
  ],
  "command_options": [
    {
      "name": "limit",
      "type": "int",
      "default": 10,
      "help": "Number of results (max 1000; use normal-sized requests)"
    },
    {
      "name": "type",
      "type": "str",
      "default": "all",
      "choices": [
        "all",
        "answer",
        "article",
        "question"
      ],
      "help": "Result type: all, answer, article, or question"
    }
  ],
  "browser_common_options": [
    {
      "name": "window",
      "flags": "--window <mode>",
      "help": "Browser window mode: foreground or background",
      "choices": [
        "foreground",
        "background"
      ]
    },
    {
      "name": "site-session",
      "flags": "--site-session <mode>",
      "help": "Adapter site session lifecycle: ephemeral or persistent",
      "choices": [
        "ephemeral",
        "persistent"
      ]
    },
    {
      "name": "keep-tab",
      "flags": "--keep-tab <bool>",
      "help": "Keep the browser tab lease after the command finishes",
      "choices": [
        "true",
        "false"
      ]
    }
  ],
  "example": "opencli zhihu search <query>",
  "defaultFormat": "json",
  "columns": [
    "rank",
    "title",
    "type",
    "author",
    "votes",
    "url"
  ],
  "common_options": [
    {
      "name": "format",
      "flags": "-f, --format <fmt>",
      "help": "Output format: table, plain, json, yaml, md, csv",
      "default": "json",
      "choices": [
        "table",
        "plain",
        "json",
        "yaml",
        "md",
        "csv"
      ]
    },
    {
      "name": "trace",
      "flags": "--trace <mode>",
      "help": "Trace capture: off, on, retain-on-failure",
      "default": "off",
      "choices": [
        "off",
        "on",
        "retain-on-failure"
      ]
    },
    {
      "name": "verbose",
      "flags": "-v, --verbose",
      "help": "Debug output",
      "default": false
    },
    {
      "name": "help",
      "flags": "-h, --help",
      "help": "display help for command"
    }
  ],
  "output_formats": [
    "table",
    "plain",
    "yaml",
    "json",
    "md",
    "csv"
  ]
}
